rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin privilege is granted only by Firebase Admin SDK Custom Claims.
    // A role field inside a user-editable document is never sufficient.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Private system markers for one-time data imports; only trusted admins may access.
    match /system/{documentId} {
      allow read, write: if isAdmin();
    }


    // Public contact directory; only a trusted Firebase admin can edit creator profiles.
    match /siteSettings/{settingId} {
      allow read: if settingId in ['contactCreators', 'maintenanceNotice'] || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email;
      allow read: if isOwner(uid) || isAdmin();
      // Members may update safe profile fields and keep their own plant-quiz history.
      // Role/status/email/uid remain protected from client-side edits.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'email', 'favorites', 'recentlyViewed',
          'lastLoginAt', 'updatedAt', 'quizHistory'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && (request.resource.data.email == resource.data.email || request.resource.data.email == request.auth.token.email)
        && request.resource.data.uid == resource.data.uid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['favorites']) || request.resource.data.favorites is list)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['recentlyViewed']) || (request.resource.data.recentlyViewed is list && request.resource.data.recentlyViewed.size() <= 30))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['quizHistory']) || (
          request.resource.data.quizHistory is list
          && request.resource.data.quizHistory.size() <= 10
        ));
      allow delete: if isAdmin();
    }

    match /plants/{plantId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10;
      allow read, update, delete: if isAdmin();
    }
    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    match /drafts/{draftId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Deny all collections not explicitly declared above.
    match /{document=**} { allow read, write: if false; }
  }
}
