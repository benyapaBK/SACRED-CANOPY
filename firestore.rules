rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin privilege is granted only by Firebase Admin SDK Custom Claims.
    // A role field inside a user-editable document is never sufficient.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Private system markers for one-time data imports; only trusted admins may access.
    match /system/{documentId} {
      allow read, write: if isAdmin();
    }


    // Public contact directory; only a trusted Firebase admin can edit creator profiles.
    match /siteSettings/{settingId} {
      allow read: if settingId == 'contactCreators' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email;
      allow read: if isOwner(uid) || isAdmin();
      // Members may update safe profile fields and their own garden-game save.
      // Role/status/email/uid remain protected from client-side edits.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'favorites', 'recentlyViewed',
          'lastLoginAt', 'updatedAt', 'gardenGameSave', 'gardenGameSavedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && request.resource.data.uid == resource.data.uid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['favorites']) || request.resource.data.favorites is list)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['recentlyViewed']) || (request.resource.data.recentlyViewed is list && request.resource.data.recentlyViewed.size() <= 30))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gardenGameSavedAt']) || request.resource.data.gardenGameSavedAt is timestamp)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gardenGameSave']) || (
          request.resource.data.gardenGameSave is map
          && request.resource.data.gardenGameSave.keys().hasOnly(['version', 'gardenName', 'sceneId', 'plantedPlantIds', 'decorationIds', 'avatarStyle', 'xp'])
          && request.resource.data.gardenGameSave.version == 1
          && request.resource.data.gardenGameSave.gardenName is string
          && request.resource.data.gardenGameSave.gardenName.size() <= 48
          && request.resource.data.gardenGameSave.sceneId in ['balcony', 'sunroom', 'garden']
          && request.resource.data.gardenGameSave.plantedPlantIds is list
          && request.resource.data.gardenGameSave.plantedPlantIds.size() <= 5
          && request.resource.data.gardenGameSave.decorationIds is list
          && request.resource.data.gardenGameSave.decorationIds.size() <= 4
          && request.resource.data.gardenGameSave.avatarStyle in ['gardener', 'sunhat', 'flower']
          && request.resource.data.gardenGameSave.xp is int
          && request.resource.data.gardenGameSave.xp >= 0
          && request.resource.data.gardenGameSave.xp <= 10000
        ));
      allow delete: if isAdmin();
    }

    match /plants/{plantId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10;
      allow read, update, delete: if isAdmin();
    }
    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    match /drafts/{draftId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    // Deny all collections not explicitly declared above.
    match /{document=**} { allow read, write: if false; }
  }
}
